# ═══════════════════════════════════════════════════════════
#  Plantilla de variables de entorno del servidor.
#
#  Copiar como .env en el servidor y llenar con los valores
#  reales. El .env NUNCA se sube al repositorio.
#
#  Permisos recomendados:  chmod 600 .env
# ═══════════════════════════════════════════════════════════

# ── Registro de imagenes ──
GH_USER=tu-usuario-de-github

# ── Dominio ──
DOMINIO=importacionescaribecr.com

# ── Base de datos ──
# Generar con: openssl rand -base64 24
DB_PASSWORD=

# ── Autenticacion ──
# Clave de firma de los tokens. Minimo 32 caracteres.
# Generar con: openssl rand -base64 48
JWT_KEY=

# ── Administrador inicial ──
# Se crea solo la primera vez que arranca el sistema.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=

# ── Almacenamiento de imagenes (Cloudflare R2) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=caribe-fotos
R2_URL_PUBLICA=https://fotos.importacionescaribecr.com

# ── Correo (Resend) ──
RESEND_API_KEY=
CORREO_REMITENTE=no-responder@importacionescaribecr.com
